{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run seo:generate-assets && vite build && node scripts/prerender.mjs && node scripts/check-programmatic-content.mjs && node scripts/check-seo-artifacts.mjs && node scripts/check-public-company-privacy.mjs && node scripts/check-zimbabwe-cluster.mjs",
    "preview": "vite preview",
    "test:browser-console": "npm run build && node scripts/check-browser-console.mjs",
    "test:snapshot-url": "npm run build && node scripts/check-snapshot-url-normalisation.mjs",
    "test:public-privacy": "node scripts/check-public-company-privacy.mjs",
    "test:email-signature": "node scripts/check-email-signature.mjs",
    "test:og-card": "node scripts/check-og-social-card.mjs",
    "test:locked-report-assets": "node scripts/check-locked-report-assets.mjs",
    "test:zimbabwe-copy": "node scripts/check-zimbabwe-client-copy.mjs",
    "test:zimbabwe-cluster": "node scripts/check-zimbabwe-cluster.mjs",
    "test:zimbabwe-cluster-browser": "node scripts/check-zimbabwe-cluster-browser.mjs",
    "test:zimbabwe-brand-parity": "node scripts/check-zimbabwe-brand-parity.mjs",
    "test:zimbabwe-enquiry": "node scripts/check-zimbabwe-enquiry.mjs",
    "test:zimbabwe-browser": "node scripts/check-zimbabwe-browser.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "seo:generate-assets": "node scripts/generate-programmatic-assets.mjs",
    "seo:indexnow:dry-run": "node scripts/indexnow.mjs --all",
    "seo:indexnow:dry-run:cohort": "node scripts/indexnow.mjs --cohort 01-industry-hubs",
    "seo:indexnow:submit": "node scripts/indexnow.mjs --submit",
    "test:programmatic-content": "npm run build",
    "test:ai-crawlers": "npm run build && node scripts/check-ai-crawlers.mjs",
    "test:programmatic-routes": "npm run build && node scripts/check-programmatic-routes.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
